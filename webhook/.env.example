# Bu dosyayı .env olarak kopyalayın ve doldurun
# cp .env.example .env

MQTT_BROKER=xxxxxxxx.s2.eu.hivemq.cloud
MQTT_USER=pcswitch
MQTT_PASS=mqtt-sifreniz

# Webhook için ayrı bir API anahtarı (client.py'deki ile aynı olmak zorunda değil)
WEBHOOK_API_KEY=webhook-icin-uzun-rastgele-sifre

# CORS: hangi domain'lerden istek gelsin?
# Hepsi için: *
# Belirli domain: https://siteniz.com,https://www.siteniz.com
ALLOWED_ORIGINS=*
